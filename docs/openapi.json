  "components": {
    "schemas": {
      "LibraryProblem": {
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "稳定业务错误码"
          },
          "requestId": {
            "type": "string",
            "description": "与日志及 X-Request-Id 对应"
          }
        }
      },
      "UpdatePolicyRequest": {
        "type": "object",
        "properties": {
          "maxActiveLoans": {
            "type": "integer",
            "format": "int32",
            "exclusiveMinimum": 0
          },
          "loanDays": {
            "type": "integer",
            "format": "int32",
            "exclusiveMinimum": 0
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "expectedVersion",
          "loanDays",
          "maxActiveLoans"
        ]
      },
      "BorrowingPolicy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "maxActiveLoans": {
            "type": "integer",
            "format": "int32"
          },
          "loanDays": {
            "type": "integer",
            "format": "int32"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BorrowRequest": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "bookId"
        ]
      },
      "LoanView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "accountNo": {
            "type": "string"
          },
          "accountName": {
            "type": "string"
          },
          "bookId": {
            "type": "integer",
            "format": "int64"
          },
          "bookTitle": {
            "type": "string"
          },
          "borrowedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "returnedAt": {
            "type": "string",
            "format": "date-time"
          },
          "overdue": {
            "type": "boolean"
          }
        }
      },
      "SlicePageLoanView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoanView"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
