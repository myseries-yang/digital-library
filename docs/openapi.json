{
  "openapi": "3.1.0",
  "info": {
    "title": "电子图书馆 / Digital Library",
    "description": "按图书馆账号独立借阅。借还与当前借阅使用 X-Library-Account-Id。该请求头是演示身份约定，不是真实认证。时间使用 UTC ISO 8601，page 从零开始。错误为 application/problem+json，包含稳定 code 与 requestId。Redis 仅用于锁；数据关联由应用事务校验，不建立数据库外键。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前服务地址"
    }
  ],
  "paths": {
    "/api/admin/borrowing-policy": {
      "put": {
        "tags": [
          "Borrowing Policy / 借阅规则"
        ],
        "summary": "修改全局规则",
        "description": "提交读取时的版本；不追溯已有借阅和已读取旧规则的请求。",
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePolicyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BorrowingPolicy"
                }
              }
            }
          },
          "400": {
            "description": "参数、账号请求头或请求格式不正确",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          },
          "404": {
            "description": "请求的资源不存在",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          },
          "500": {
            "description": "内部错误或数据一致性异常",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用或提交结果未确认；请结合 code 判定，不自动重放借阅",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          },
          "409": {
            "description": "重复在借、名额/额度不足或规则版本冲突",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/loans": {
