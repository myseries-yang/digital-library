    "/api/admin/loans": {
      "get": {
        "tags": [
          "Loans / 借阅"
        ],
        "summary": "按账号、图书或状态查询借阅",
        "description": "CURRENT 包含逾期；本次管理入口不包含真实权限系统。",
        "operationId": "adminSearch",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          },
          {
            "name": "bookId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ALL",
              "enum": [
                "ALL",
                "CURRENT",
                "OVERDUE",
                "RETURNED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
