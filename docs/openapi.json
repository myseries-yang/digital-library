            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryProblem"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用或提交结果未确认；请结合 code 判定，不自动重放借阅",
            "content": {
              "application/problem+json": {
